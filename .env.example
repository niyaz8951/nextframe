# PostgreSQL connection string. Leave empty to run on the embedded
# Postgres (PGlite) stored in ./.data - handy for local play, not for production.
DATABASE_URL=

# Long random string used to sign login tokens. REQUIRED in production.
JWT_SECRET=

PORT=3000

# Optional -------------------------------------------------------------
# TLS for the database: require | verify. Turned on automatically for Supabase, Neon and Render URLs.
DATABASE_SSL=
# Maximum open database connections (keep at or below your provider's pool limit).
DATABASE_POOL=8
# Origin of the frontend if it is hosted separately (e.g. Cloudflare Pages).
CORS_ORIGIN=
# Background drift: every HEARTBEAT_SECONDS the universe advances HEARTBEAT_TICKS
# on its own, so it keeps moving when nobody is online. 0 disables.
HEARTBEAT_SECONDS=60
HEARTBEAT_TICKS=5
# Set to 1 when running behind a reverse proxy (needed for rate limiting by IP).
TRUST_PROXY=0
